rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Het hele team deelt één login (zie BVC_FIREBASE_SETUP): iedereen die is
    // ingelogd werkt in dezelfde klanten- en actielijst-data, er is geen
    // scheiding per gebruiker.
    match /klanten/{klantId} {
      allow read, write: if request.auth != null;
    }

    match /acties/{actieId} {
      allow read, write: if request.auth != null;
    }

    // Versiebeheer: read-only snapshots van een actielijst op het moment dat
    // een vergadering wordt afgesloten. Zie BVC_WEBAPP_PROJECT_v03.md.
    match /klanten/{klantId}/versies/{versieId} {
      allow read, write: if request.auth != null;
    }

    // Huurdersmutaties: losstaande tak van de app, niet gekoppeld aan een klant.
    match /mutaties/{mutatieId} {
      allow read, write: if request.auth != null;
    }

    // Instellingen (o.a. de lijst met jaren voor Huurdersmutaties).
    match /instellingen/{instellingId} {
      allow read, write: if request.auth != null;
    }

    // Panden, documenten en jaarlijks onderhoud — zie BVC_WEBAPP_PROJECT.
    match /panden/{pandId} {
      allow read, write: if request.auth != null;
    }

    match /documenten/{documentId} {
      allow read, write: if request.auth != null;
    }

    match /onderhoud/{onderhoudId} {
      allow read, write: if request.auth != null;
    }

    // Systeembrede, door het hele team beheerbare lijst van onderhoudstypen —
    // los van een specifiek pand. Zie VOORSTEL rapportage/onderhoud/mjop §3.
    match /onderhoudStandaardlijst/{typeId} {
      allow read, write: if request.auth != null;
    }

    // MJOP: meerjarenplanning grootonderhoud per pand.
    match /mjop/{postId} {
      allow read, write: if request.auth != null;
    }

    // Systeembrede, door het hele team beheerbare lijst van MJOP-types —
    // analoog aan onderhoudStandaardlijst hierboven.
    match /mjopStandaardlijst/{typeId} {
      allow read, write: if request.auth != null;
    }
  }
}
