rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Het hele team deelt één login (zie BVC_FIREBASE_SETUP): iedereen die is
    // ingelogd werkt in dezelfde klanten- en actielijst-data, er is geen
    // scheiding per gebruiker.
    match /klanten/{klantId} {
      allow read, write: if request.auth != null;
    }

    match /acties/{actieId} {
      allow read, write: if request.auth != null;
    }
  }
}
