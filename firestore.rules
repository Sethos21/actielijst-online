rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each actielijst document is owned by the authenticated user who created it.
    // Adjust this once client/organisation sharing rules are defined.
    match /actielijsten/{listId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
    }
  }
}
