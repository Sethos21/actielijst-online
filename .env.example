# Firebase web app config (from Firebase Console > Project settings > General > Your apps)
# These values are not secret, but keeping them out of source control makes it
# easy to point different environments (local/staging) at different projects.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
